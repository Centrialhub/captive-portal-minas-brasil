# Frontend build (publishable values only)
VITE_SUPABASE_URL=https://fqamejlyytrhovawgtwg.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Supabase Edge Function runtime
SUPABASE_URL=https://fqamejlyytrhovawgtwg.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key-here
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Integrations
CLUBEMAIS_API_TOKEN=your-token-here
POST_AUTH_REDIRECT_URL=https://www.drogariaminasbrasil.com.br/
PASSWORD_RESET_REDIRECT_URL=https://minasbrasilwifi.com.br/reset-password
CRON_SECRET=generate-a-long-random-value

# UniFi
UNIFI_USERNAME=your-user
UNIFI_PASSWORD=your-password
# Legacy self-hosted controllers authenticate with unifises/TOKEN cookies.
# Use unifi-os only for a UniFi OS console; auto is available during migrations.
UNIFI_AUTH_MODE=legacy

# Release gate (CI/homologation only; do not expose to the frontend)
COMMIT_SHA=replace-with-the-exact-git-sha
CONCURRENCY_TEST_URL=https://staging.example.com/api/captive-portal/?route=%2Fauthorize-existing
CONCURRENCY_TEST_PAYLOAD={"attempt_id":"staging-uuid","resume_token":"one-time-token","access_token":"staging-user-jwt"}
# Set only after rotating the credential documented as compromised.
UNIFI_CREDENTIALS_ROTATED=false
# Set only after enabling Auth > Attack Protection > Leaked Password Protection.
SUPABASE_LEAKED_PASSWORD_PROTECTION_ENABLED=false

# Post-deploy verification
EXPECTED_COMMIT_SHA=replace-with-the-exact-git-sha
PRODUCTION_PORTAL_ORIGIN=https://minasbrasilwifi.com.br
PRODUCTION_UNIFI_HEALTH_URL=https://unifiproxy.minasbrasilwifi.com.br/healthz
PRODUCTION_VERIFY_TIMEOUT_MS=15000
